{
  "name": "eztheme",
  "version": "0.1.0",
  "description": "Themes as data: 15 app looks, 28 form looks and a Material 3 Studio theme, the colour rules that derive the rest, contrast checks, and CSS custom properties in ezinputs or Material 3 names. Zero dependencies.",
  "license": "MIT",
  "author": "James Dominguez",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js",
      "require": "./dist/cjs/dom.cjs"
    },
    "./mui": {
      "types": "./dist/mui.d.ts",
      "import": "./dist/mui.js",
      "require": "./dist/cjs/mui.cjs"
    },
    "./color": {
      "types": "./dist/color.d.ts",
      "import": "./dist/color.js",
      "require": "./dist/cjs/color.cjs"
    },
    "./derive": {
      "types": "./dist/derive.d.ts",
      "import": "./dist/derive.js",
      "require": "./dist/cjs/derive.cjs"
    },
    "./forms": {
      "types": "./dist/forms.d.ts",
      "import": "./dist/forms.js",
      "require": "./dist/cjs/forms.cjs"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js",
      "require": "./dist/cjs/layout.cjs"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js",
      "require": "./dist/cjs/tokens.cjs"
    },
    "./app-themes": {
      "types": "./dist/themes/app.d.ts",
      "import": "./dist/themes/app.js",
      "require": "./dist/cjs/themes-app.cjs"
    },
    "./themes.css": "./dist/themes.css",
    "./studio.css": "./dist/studio.css",
    "./layouts.css": "./dist/layouts.css",
    "./bundle": "./dist/eztheme.min.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "theme",
    "design-tokens",
    "css-variables",
    "material-3",
    "contrast",
    "wcag",
    "palette"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JamesMDominguez/eztheme.git"
  },
  "homepage": "https://github.com/JamesMDominguez/eztheme#readme",
  "bugs": {
    "url": "https://github.com/JamesMDominguez/eztheme/issues"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/build.mjs",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "npm run build && node scripts/serve.mjs",
    "readme-images": "node scripts/readme-images.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
